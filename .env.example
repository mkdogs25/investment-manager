# Backend configuration. Every value is optional — the defaults work out of the box.
# Nothing here is read by the frontend; all outbound API calls happen server-side.

# Data provider selection ("mfapi" is the only one shipped today).
MF_PROVIDER=mfapi
MFAPI_BASE_URL=https://api.mfapi.in

# HTTP behaviour
MF_HTTP_TIMEOUT=15
MF_HTTP_RETRIES=2
MF_SCHEME_LIST_TTL=21600
MF_NAV_CACHE_TTL=3600

# Analytics
MF_RISK_FREE_RATE=0.06
MF_TRADING_DAYS=252
MF_MIN_RISK_OBS=60

# Comma-separated list of allowed browser origins
MF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
